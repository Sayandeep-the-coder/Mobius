# ==============================================================================
# Mobius Environment Variables Template
# ==============================================================================
# Copy this file to:
#   - Root .env (and .env.local for Next.js)
#   - apps/api/.env
#   - apps/typewriter-poc/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Monad Testnet (Execution Harness & Typewriter POC)
# ------------------------------------------------------------------------------
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143

# ------------------------------------------------------------------------------
# 2. Ethereum Sepolia (Aave V3 Protocol Test Market)
# ------------------------------------------------------------------------------
# A working public Sepolia RPC fallback is provided below.
# For production/heavy testing, replace with your dedicated Alchemy or Infura URL:
# e.g., https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111

# ------------------------------------------------------------------------------
# 3. Aave V3 Sepolia Address Registry (Official Address Book)
# ------------------------------------------------------------------------------
AAVE_SEPOLIA_POOL_ADDRESSES_PROVIDER=0x012bAC54348C0E635dCAc9D5FB99f06F24136C9A
AAVE_SEPOLIA_POOL=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
AAVE_SEPOLIA_DATA_PROVIDER=0x3e9708d80f7B3e43118013075F7e95CE3AB31F31
AAVE_SEPOLIA_ORACLE=0x2c8846c93425028F5c421e428c0451cf4499ff35

# Reserve Assets & Receipt aTokens (Sepolia)
AAVE_SEPOLIA_DAI=0xFF34B3d4Aee8ddCd6F9AFFFB6Fe49bD371b8a357
AAVE_SEPOLIA_ADAI=0x29598b72eb5CeBd806C5dCD549490FdA35B13cD8
AAVE_SEPOLIA_USDC=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8
AAVE_SEPOLIA_AUSDC=0x16dA4541049010e31260400030026eE1bA67dCeB

# ------------------------------------------------------------------------------
# 4. Express API Backend (apps/api)
# ------------------------------------------------------------------------------
PORT=8787
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8787

# ------------------------------------------------------------------------------
# 5. Typewriter Mutation Execution POC (apps/typewriter-poc)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://mobius:mobius_dev_password@localhost:5432/mobius
TYPEWRITER_CONTRACT_ADDRESS=
TYPEWRITER_SCHEDULER_ADDRESS=
TYPEWRITER_SCHEDULER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 6. LLM Integration & Providers (@mobius/llm-adapter)
# ------------------------------------------------------------------------------
# Set LLM_ENABLED=true to enable natural language planning and explanation.
# Default is false (uses deterministic mock provider without requiring an API key).
LLM_ENABLED=false
LLM_PROVIDER=mock   # mock | groq | openai | anthropic
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=

# Groq Configuration (required when LLM_PROVIDER=groq)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI / Anthropic Configuration (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 7. Smart Contracts & Deployer Wallets (Monad Testnet - Optional)
# ------------------------------------------------------------------------------
# Used by Teammate 1 / Agent B for contract deployment
MONAD_DEPLOYER_PRIVATE_KEY=
SEPOLIA_TEST_PRIVATE_KEY=
MOCK_SWAP_TARGET_ADDRESS=
