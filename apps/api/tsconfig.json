{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@mobius/chain-config": ["../../packages/chain-config/src/index.ts"],
      "@mobius/contracts-abi": ["../../packages/contracts-abi/src/index.ts"],
      "@mobius/simulation": ["../../packages/simulation/src/index.ts"],
      "@mobius/policies": ["../../packages/policies/src/index.ts"],
      "@mobius/llm-adapter": ["../../packages/llm-adapter/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
